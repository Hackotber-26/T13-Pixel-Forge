# Copy to .env and fill in. Never commit .env.

# WhatsApp Cloud API (Meta App Dashboard)
WA_VERIFY_TOKEN=           # any secret string; the same value goes in Meta's webhook settings
WA_APP_SECRET=             # App settings -> Basic -> App secret
WA_ACCESS_TOKEN=           # System User token with whatsapp_business_messaging
WA_PHONE_NUMBER_ID=        # the sending number's Phone Number ID
WA_DISPLAY_NUMBER=         # the sending number, digits only (used for Verify with WhatsApp links)

# Supabase Postgres (session pooler) - role raksha_app, see supabase/migrations/0003_app_role.sql
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_USER=raksha_app.<project-ref>
DB_PASSWORD=

# Signs sessions and one-tap links: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

# Public address of the web app (tunnel or domain); used in WhatsApp links
WEB_BASE_URL=http://localhost:5173

# Comma-separated test recipients (digits with country code), used by scripts/send_welcome.py
TEST_PHONES=
